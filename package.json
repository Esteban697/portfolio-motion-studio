{
  "name": "portfolio-motion-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, AI-assisted cinematic video production pipeline built on Remotion.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "assets": "tsx scripts/generate-assets.ts",
    "predev": "npm run assets",
    "compositions": "remotion compositions",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run assets",
    "test": "vitest run",
    "pretest": "npm run assets",
    "validate": "tsx scripts/validate-project.ts",
    "render:sample": "remotion render CinematicSample out/cinematic-sample-1080p.mp4",
    "prerender:sample": "npm run assets",
    "render:sample:preview": "remotion render CinematicSample out/cinematic-sample-preview.mp4 --scale=0.5",
    "prerender:sample:preview": "npm run assets",
    "still:sample": "remotion still CinematicSample out/cinematic-sample-poster.png --frame=150",
    "prestill:sample": "npm run assets"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.542",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
